<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Asosiy mavzu (splash tugagach) -->
    <style name="Theme.ApkAntivirus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cyber_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ tizim splash ekrani (eski versiyalarda ham ishlaydi) -->
    <style name="Theme.ApkAntivirus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cyber_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ApkAntivirus</item>
    </style>
</resources>
